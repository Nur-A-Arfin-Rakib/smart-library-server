PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-library
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# --- Google Login (optional — leave blank to disable) ---
# Get this from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# --- Stripe fine payments (optional — leave blank to disable) ---
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# From https://dashboard.stripe.com/test/webhooks (after adding an endpoint)
STRIPE_WEBHOOK_SECRET=

# --- Email notifications via Gmail (optional — leave blank to disable) ---
# EMAIL_USER is your Gmail address.
# EMAIL_APP_PASSWORD is a 16-character App Password, NOT your normal Gmail
# password. Generate one at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the Google account first).
EMAIL_USER=
EMAIL_APP_PASSWORD=
